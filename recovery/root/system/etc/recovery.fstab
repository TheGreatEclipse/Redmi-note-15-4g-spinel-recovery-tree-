# Android fstab file – Redmi Note 15 4G (spinel / MT6789)
# Recovery fstab for TWRP (vendor_boot partition layout)

# ── Logical partitions ────────────────────────────────────────
system       /system      erofs  ro  wait,slotselect,logical
vendor       /vendor      erofs  ro  wait,slotselect,logical
product      /product     erofs  ro  wait,slotselect,logical
system_ext   /system_ext  erofs  ro  wait,slotselect,logical
vendor_dlkm  /vendor_dlkm erofs  ro  wait,slotselect,logical
odm_dlkm     /odm_dlkm   erofs  ro  wait,slotselect,logical
system_dlkm  /system_dlkm erofs  ro  wait,slotselect,logical

# ── Userdata / Metadata (FBE) ─────────────────────────────────
/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# ── Misc / Cache ──────────────────────────────────────────────
/dev/block/by-name/misc   /misc   emmc defaults defaults

# ── Flashable partitions (TWRP backup/restore) ────────────────
/boot           emmc /dev/block/by-name/boot           flags=display=boot;slotselect;backup;flashimg
/vendor_boot    emmc /dev/block/by-name/vendor_boot    flags=display=vendor_boot;slotselect;backup;flashimg
/vbmeta         emmc /dev/block/by-name/vbmeta         flags=display=vbmeta;slotselect;backup;flashimg
/vbmeta_system  emmc /dev/block/by-name/vbmeta_system  flags=display=vbmeta_system;slotselect;backup;flashimg
/vbmeta_vendor  emmc /dev/block/by-name/vbmeta_vendor  flags=display=vbmeta_vendor;slotselect;backup;flashimg
/dtbo           emmc /dev/block/by-name/dtbo           flags=display=dtbo;slotselect;backup
/metadata       ext4 /dev/block/by-name/metadata       flags=display=metadata;backup
/logo           emmc /dev/block/by-name/logo           flags=display=logo;slotselect;backup

# ── Sensitive data ────────────────────────────────────────────
/nvcfg          ext4 /dev/block/by-name/nvcfg          flags=display=nvcfg;backup
/nvdata         ext4 /dev/block/by-name/nvdata          flags=display=nvdata;backup
/protect_f      ext4 /dev/block/by-name/protect1        flags=display=protect_f;backup
/protect_s      ext4 /dev/block/by-name/protect2        flags=display=protect_s;backup
/nvram          emmc /dev/block/by-name/nvram            flags=display=nvram;backup
/persistent     emmc /dev/block/by-name/frp             flags=display=persistent;backup

# ── MTK specific ──────────────────────────────────────────────
/expdb  emmc /dev/block/by-name/expdb  flags=display=expdb
/otp    emmc /dev/block/by-name/otp    flags=display=otp
/seccfg emmc /dev/block/by-name/seccfg flags=display=seccfg
/spmfw  emmc /dev/block/by-name/spmfw  flags=display=spmfw;slotselect
/tee1   emmc /dev/block/by-name/tee1   flags=display=tee1
/tee2   emmc /dev/block/by-name/tee2   flags=display=tee2

# ── Removable storage ─────────────────────────────────────────
/external_sd  auto /dev/block/mmcblk1p1 /dev/block/mmcblk0p1 flags=display="Micro SD Card";storage;wipeingui;removable;backup=0
/usb_otg      auto /dev/block/sdd       /dev/block/sdd1       flags=display="USB-OTG";storage;wipeingui;removable;backup=0

# ── Flashable logical partition images ────────────────────────
/system_image      emmc /dev/block/bootdevice/by-name/system      flags=backup;flashimg
/vendor_image      emmc /dev/block/bootdevice/by-name/vendor      flags=backup;flashimg
/system_ext_image  emmc /dev/block/bootdevice/by-name/system_ext  flags=display="System_EXT Image";backup;flashimg
/product_image     emmc /dev/block/bootdevice/by-name/product     flags=display="Product Image";backup;flashimg
/vendor_dlkm_image emmc /dev/block/bootdevice/by-name/vendor_dlkm flags=display="VendorDLKM Image";backup;flashimg
